# Maintainer: Kubism contributors
# Arch Linux / Omarchy package built from the release tarball (Native AOT, x86_64).
# Local build:  cp ../../artifacts/Kubism-<ver>-linux-x64.tar.gz . && makepkg -f   then   sudo pacman -U kubism-bin-*.pkg.tar.zst
pkgname=kubism-bin
pkgver=${KUBISM_VERSION:-0.1.0}
pkgrel=1
pkgdesc="Kubism: multi-cluster Kubernetes desktop (Inspect. Steer. Monitor.)"
arch=('x86_64')
url="https://github.com/pgourlain/kubism"
license=('MIT')
depends=('fontconfig' 'libx11' 'libice' 'libsm' 'icu' 'openssl' 'krb5' 'zlib')
optdepends=('helm: rollback and uninstall of Helm releases' 'azure-cli: Azure Monitor managed Prometheus')
options=('!strip' '!debug')
source=("Kubism-$pkgver-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/kubism-$pkgver"
  install -d "$pkgdir/opt/kubism" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/licenses/$pkgname"
  cp -r opt/kubism/. "$pkgdir/opt/kubism/"
  chmod +x "$pkgdir/opt/kubism/Kubism"
  ln -s /opt/kubism/Kubism "$pkgdir/usr/bin/kubism"
  install -Dm644 usr/share/applications/kubism.desktop "$pkgdir/usr/share/applications/kubism.desktop"
  install -Dm644 opt/kubism/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 opt/kubism/THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
  cp -r opt/kubism/third-party "$pkgdir/usr/share/licenses/$pkgname/third-party"
  install -Dm644 opt/kubism/kubism.png "$pkgdir/usr/share/pixmaps/kubism.png"
}
