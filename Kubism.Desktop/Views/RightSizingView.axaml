<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:c="using:Kubism.Desktop.Controls"
             xmlns:rs="using:Kubism.Core.RightSizing"
             xmlns:app="using:Kubism.Desktop"
             x:Class="Kubism.Desktop.Views.RightSizingView"
             x:DataType="vm:RightSizingViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="Right-sizing" Classes="h1" />
        <TextBlock Text="{Binding SourceInfo}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StrategyInfo}" Classes="muted" FontSize="11" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="220" AutomationProperties.Name="Usage source">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SourceChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding WindowChoices}" SelectedItem="{Binding WindowDays}" AutomationProperties.Name="Window in days">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Int32"><TextBlock Text="{Binding StringFormat='{}{0} d'}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
        <c:RefreshButton Command="{Binding LoadCommand}" />
      </StackPanel>
    </Grid>

    <!-- 1-3: what the nodes offer, what is used now, how requests and limits compare -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Classes="card" IsVisible="{Binding CpuCard, Converter={x:Static app:Converters.NotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Text="CPU" Classes="sectionTitle" />
          <c:UsageBar Height="18" Capacity="{Binding CpuCard.Capacity}" P95="{Binding CpuCard.UsedNow}" Max="{Binding CpuCard.UsedP95}" Request="{Binding CpuCard.Requested}" Limit="{Binding CpuCard.Limits}" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Available" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding CpuCard.CapacityText}" />
            <TextBlock Grid.Row="1" Text="Used now" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuCard.UsedNowText}" Foreground="{DynamicResource KubismAccentBrush}" />
            <TextBlock Grid.Row="2" Text="Requested" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuCard.RequestedText}" Foreground="{DynamicResource KubismWarnBrush}" />
            <TextBlock Grid.Row="3" Text="Limits" Classes="muted" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CpuCard.LimitsText}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" IsVisible="{Binding MemoryCard, Converter={x:Static app:Converters.NotNull}}">
        <StackPanel Spacing="6">
          <TextBlock Text="MEMORY" Classes="sectionTitle" />
          <c:UsageBar Height="18" Capacity="{Binding MemoryCard.Capacity}" P95="{Binding MemoryCard.UsedNow}" Max="{Binding MemoryCard.UsedP95}" Request="{Binding MemoryCard.Requested}" Limit="{Binding MemoryCard.Limits}" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Available" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding MemoryCard.CapacityText}" />
            <TextBlock Grid.Row="1" Text="Used now" Classes="muted" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryCard.UsedNowText}" Foreground="{DynamicResource KubismAccentBrush}" />
            <TextBlock Grid.Row="2" Text="Requested" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryCard.RequestedText}" Foreground="{DynamicResource KubismWarnBrush}" />
            <TextBlock Grid.Row="3" Text="Limits" Classes="muted" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemoryCard.LimitsText}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ComboBox ItemsSource="{Binding VerdictFilters}" SelectedItem="{Binding VerdictFilter}" AutomationProperties.Name="Verdict filter" />
      <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortBy}" AutomationProperties.Name="Sort by" />
      <TextBox Text="{Binding KindFilter}" PlaceholderText="Namespace / kind / name" Width="220" />
      <TextBlock Text="Min waste (cores)" VerticalAlignment="Center" Classes="muted" />
      <NumericUpDown Value="{Binding MinWasteCores}" Minimum="0" Increment="0.05" FormatString="0.00" Width="140" />
      <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsLoading}" />
      <TextBlock Text="{Binding ConnectionResult}" Classes="muted" />
    </StackPanel>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource KubismErrorBrush}" IsVisible="{Binding Error, Converter={x:Static app:Converters.NotNull}}" TextWrapping="Wrap" />
    </StackPanel>

    <TabControl Grid.Row="3">
      <TabItem Header="Misconfigured">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="{Binding ProblemsTitle}" FontWeight="SemiBold" Margin="2,6,0,6" />
          <DataGrid Grid.Row="1" Name="ProblemsGrid" ItemsSource="{Binding Problems}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserResizeColumns="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" SelectionMode="Single" AutomationProperties.Name="Misconfigured containers">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" AutomationProperties.Name="Select container" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Verdict" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel">
                    <Border Classes="pill" Margin="4" HorizontalAlignment="Left" BorderBrush="{Binding VerdictSeverity, Converter={x:Static app:Converters.SeverityBrush}}">
                      <TextBlock Text="{Binding Verdict}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding VerdictSeverity, Converter={x:Static app:Converters.SeverityBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Workload" Binding="{Binding Workload}" x:DataType="vm:ContainerRowViewModel" Width="1.2*" MinWidth="160" />
              <DataGridTextColumn Header="What is wrong" Binding="{Binding Problem}" x:DataType="vm:ContainerRowViewModel" Width="2.2*" MinWidth="240" />
              <DataGridTextColumn Header="Suggested" Binding="{Binding Fix}" x:DataType="vm:ContainerRowViewModel" Width="1.4*" MinWidth="170" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="All containers">
        <Grid>
          <DataGrid Name="ContainersGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserResizeColumns="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" SelectionMode="Single" AutomationProperties.Name="Containers">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="40">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" AutomationProperties.Name="Select container" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" x:DataType="vm:ContainerRowViewModel" />
              <DataGridTextColumn Header="Workload" Binding="{Binding Workload}" x:DataType="vm:ContainerRowViewModel" Width="1.5*" MinWidth="170" />
              <DataGridTextColumn Header="Container" Binding="{Binding Container}" x:DataType="vm:ContainerRowViewModel" />
              <DataGridTextColumn Header="Repl." Binding="{Binding Replicas}" x:DataType="vm:ContainerRowViewModel" />
              <DataGridTemplateColumn Header="CPU  (req | p95 | max)" Width="1.3*" MinWidth="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel">
                    <StackPanel Margin="6,2" Spacing="1">
                      <c:UsageBar Request="{Binding CpuRequestV}" Limit="{Binding CpuLimitV}" P95="{Binding CpuP95V}" Max="{Binding CpuMaxV}" />
                      <TextBlock FontSize="10" Classes="muted"><Run Text="{Binding CpuRequest}" /><Run Text=" | " /><Run Text="{Binding CpuP95}" /><Run Text=" | " /><Run Text="{Binding CpuMax}" /></TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding RecCpu}" x:DataType="vm:ContainerRowViewModel">
                <DataGridTextColumn.Header>
                  <TextBlock Text="CPU rec.">
                    <ToolTip.Tip>
                      <TextBlock MaxWidth="320" TextWrapping="Wrap" Text="Recommended CPU request: the 95th percentile of CPU usage over the window (minimum 10m), rounded up to a sensible step. No CPU limit is recommended by default, so the container is not throttled. Empty when there is not enough data." />
                    </ToolTip.Tip>
                  </TextBlock>
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Memory  (req | p95 | max)" Width="1.3*" MinWidth="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel">
                    <StackPanel Margin="6,2" Spacing="1">
                      <c:UsageBar Request="{Binding MemRequestV}" Limit="{Binding MemLimitV}" P95="{Binding MemP95V}" Max="{Binding MemMaxV}" />
                      <TextBlock FontSize="10" Classes="muted"><Run Text="{Binding MemoryRequest}" /><Run Text=" | " /><Run Text="{Binding MemoryP95}" /><Run Text=" | " /><Run Text="{Binding MemoryMax}" /></TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding RecMemory}" x:DataType="vm:ContainerRowViewModel">
                <DataGridTextColumn.Header>
                  <TextBlock Text="Mem rec.">
                    <ToolTip.Tip>
                      <TextBlock MaxWidth="320" TextWrapping="Wrap" Text="Recommended memory request: the highest working set seen over the window, plus a 15 % safety margin (minimum 32 Mi), rounded to a sensible step. By default the recommended limit equals this request. Empty when there is not enough data." />
                    </ToolTip.Tip>
                  </TextBlock>
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Verdict">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ContainerRowViewModel">
                    <Border CornerRadius="9" Padding="8,1" Margin="4" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{Binding VerdictSeverity, Converter={x:Static app:Converters.SeverityBrush}}">
                      <TextBlock Text="{Binding Verdict}" FontSize="11" Foreground="{Binding VerdictSeverity, Converter={x:Static app:Converters.SeverityBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Waste" Binding="{Binding Waste}" x:DataType="vm:ContainerRowViewModel" />
              <DataGridTextColumn Header="Managed by" Binding="{Binding GitOps}" x:DataType="vm:ContainerRowViewModel" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Namespaces">
        <DataGrid ItemsSource="{Binding Rollups}" IsReadOnly="True" CanUserResizeColumns="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" x:DataType="rs:NamespaceRollup" Width="*" />
            <DataGridTextColumn Header="CPU requested" Binding="{Binding CpuRequested, StringFormat='{}{0:0.###}'}" x:DataType="rs:NamespaceRollup" />
            <DataGridTextColumn Header="CPU used (p95)" Binding="{Binding CpuUsedP95, StringFormat='{}{0:0.###}'}" x:DataType="rs:NamespaceRollup" />
            <DataGridTextColumn Header="CPU waste" Binding="{Binding WasteCpu, StringFormat='{}{0:0.###}'}" x:DataType="rs:NamespaceRollup" />
            <DataGridTextColumn Header="Memory requested" Binding="{Binding MemoryRequested, Converter={x:Static app:Converters.Bytes}}" x:DataType="rs:NamespaceRollup" />
            <DataGridTextColumn Header="Memory used (p95)" Binding="{Binding MemoryUsedP95, Converter={x:Static app:Converters.Bytes}}" x:DataType="rs:NamespaceRollup" />
            <DataGridTextColumn Header="Memory waste" Binding="{Binding WasteMemory, Converter={x:Static app:Converters.Bytes}}" x:DataType="rs:NamespaceRollup" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Patch preview">
        <TextBox Text="{Binding PatchPreview}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
      </TabItem>
    </TabControl>

    <Border Grid.Row="4" Classes="card" IsVisible="{Binding Selected, Converter={x:Static app:Converters.NotNull}}">
      <StackPanel Spacing="6">
      <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsDetailLoading}" AutomationProperties.Name="Loading details" />
      <Grid ColumnDefinitions="*,*,1.2*" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" TextWrapping="Wrap"><Run Text="{Binding Selected.Workload}" /><Run Text=" / " /><Run Text="{Binding Selected.Container}" /></TextBlock>
          <TextBlock Text="CPU over the window (request orange)" FontSize="11" Classes="muted" />
          <c:Sparkline Height="64" Values="{Binding CpuSeries}" Request="{Binding Selected.CpuRequestV}" Limit="{Binding Selected.CpuLimitV}" />
          <TextBlock Text="{Binding SeriesNote}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock FontSize="11" Classes="muted" TextWrapping="Wrap"><Run Text="OOMKills " /><Run Text="{Binding Selected.Report.OomKills}" /><Run Text="  restarts " /><Run Text="{Binding Selected.Report.Restarts}" /><Run Text="  throttled " /><Run Text="{Binding Selected.Report.ThrottledRatio, StringFormat='{}{0:P0}'}" /></TextBlock>
          <TextBlock Text="Memory working set (request orange, limit dashed)" FontSize="11" Classes="muted" />
          <c:Sparkline Height="64" Values="{Binding MemorySeries}" Request="{Binding Selected.MemRequestV}" Limit="{Binding Selected.MemLimitV}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Patch preview (spec.template.spec.containers[*].resources)" FontSize="11" Classes="muted" />
          <TextBox Text="{Binding PatchPreview}" IsReadOnly="True" AcceptsReturn="True" Height="64" FontFamily="Menlo,Consolas,monospace" FontSize="11" />
        </StackPanel>
      </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Classes="card">
      <StackPanel Spacing="4">
        <WrapPanel>
          <TextBlock Text="Recommendations" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Tick containers in the table above, then apply the recommended requests/limits or take them elsewhere." />
          <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="All" Command="{Binding SelectAllVisibleCommand}" Padding="8,2" Margin="0,0,4,0" ToolTip.Tip="Tick every container that has a recommendation" />
          <Button Content="None" Command="{Binding ClearSelectionCommand}" Padding="8,2" Margin="0,0,12,0" />
          <TextBlock Text="{Binding ApplyBlockedReason}" FontSize="12" Foreground="{DynamicResource KubismWarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ApplyBlockedReason, Converter={x:Static app:Converters.NotNull}}" />
        </WrapPanel>
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,2">
            <TextBlock Text="Apply" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Apply…" Command="{Binding ApplyCommand}" IsEnabled="{Binding ApplyBlockedReason, Converter={x:Static app:Converters.IsNull}}" ToolTip.Tip="Patch the workloads in the cluster (triggers a rollout)" />
            <CheckBox Content="Override GitOps/Helm" IsChecked="{Binding OverrideGitOps}" ToolTip.Tip="Allow applying to workloads managed by Argo CD, Flux or Helm; the change will be reverted at their next sync" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,2">
            <TextBlock Text="Copy as" Classes="muted" VerticalAlignment="Center" />
            <Button Content="YAML" Command="{Binding CopyYamlCommand}" ToolTip.Tip="resources: blocks as plain YAML" />
            <Button Content="Helm values" Command="{Binding CopyHelmCommand}" ToolTip.Tip="resources: block per container for values.yaml" />
            <Button Content="Kustomize" Command="{Binding CopyKustomizeCommand}" ToolTip.Tip="Kustomize patch" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
            <TextBlock Text="Other" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Create VPA" Command="{Binding CreateVpaCommand}" ToolTip.Tip="Create a VerticalPodAutoscaler in recommend-only mode (updateMode: Off)" />
            <Button Content="CSV…" Command="{Binding ExportCsvCommand}" ToolTip.Tip="Export the report as CSV" />
            <Button Content="Markdown…" Command="{Binding ExportMarkdownCommand}" ToolTip.Tip="Export the report as Markdown" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
