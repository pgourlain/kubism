<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kubism.Desktop.ViewModels"
        xmlns:v="using:Kubism.Desktop.Views"
        xmlns:app="using:Kubism.Desktop"
        x:Class="Kubism.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinWidth="900" MinHeight="560">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- In-window menu (non-macOS); macOS gets a NativeMenu built from the same MenuSpec records. -->
    <Menu Name="MainMenu" Grid.Row="0" />

    <Grid Grid.Row="1" ColumnDefinitions="250,Auto,*">
      <!-- Cluster catalog -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" Background="{DynamicResource KubismCatalogBrush}">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,10,8,6">
          <TextBlock Text="Clusters" Classes="h2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Command="{Binding AddKubeconfigCommand}" ToolTip.Tip="Add kubeconfig file…" AutomationProperties.Name="Add kubeconfig file" Content="+" />
          <Button Grid.Column="2" Classes="link" Command="{Binding ReloadCatalogCommand}" ToolTip.Tip="Reload" AutomationProperties.Name="Reload clusters" Content="⟳" />
        </Grid>
        <ListBox Name="CatalogList" Grid.Row="1" ItemsSource="{Binding Clusters}" SelectedItem="{Binding SelectedCluster}" Background="Transparent" AutomationProperties.Name="Cluster catalog">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ClusterItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Connect" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ConnectCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Disconnect" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DisconnectCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Edit cluster settings…" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditClusterCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Pin / unpin" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Move up" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Move down" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Color, Converter={x:Static app:Converters.HexBrush}}" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Host}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasError}" Foreground="{DynamicResource KubismErrorBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="48" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Border IsVisible="{Binding IsProduction}" Background="{DynamicResource KubismProductionBrush}" CornerRadius="3" Padding="4,0">
                    <TextBlock Text="PROD" Foreground="White" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <Border IsVisible="{Binding IsReadOnly}" Background="{DynamicResource KubismReadOnlyBrush}" CornerRadius="3" Padding="4,0">
                    <TextBlock Text="RO" Foreground="White" FontSize="9" FontWeight="Bold" />
                  </Border>
                  <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={x:Static app:Converters.StateBrush}}" ToolTip.Tip="{Binding StatusText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource KubismBorderBrush}" />

      <!-- Workspaces -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <ListBox Name="WorkspaceTabs" Grid.Row="0" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" IsVisible="{Binding HasWorkspaces}"
                 Background="{DynamicResource KubismCatalogBrush}" AutomationProperties.Name="Connected clusters">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open side by side" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenSideBySideCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Close" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CloseWorkspaceCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <Border Width="4" Height="18" CornerRadius="2" Background="{Binding Color, Converter={x:Static app:Converters.HexBrush}}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Border IsVisible="{Binding IsProduction}" Background="{DynamicResource KubismProductionBrush}" CornerRadius="3" Padding="4,0"><TextBlock Text="PROD" Foreground="White" FontSize="9" FontWeight="Bold" /></Border>
                <Button Classes="link" Content="×" Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CloseWorkspaceCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Close cluster tab" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" IsVisible="{Binding !ShowWelcome}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding HasSecondary, Converter={x:Static app:Converters.SplitColumn}}" />
          </Grid.ColumnDefinitions>
          <ContentControl Name="PrimaryPane" Content="{Binding SelectedWorkspace}" />
          <GridSplitter Grid.Column="1" Width="4" IsVisible="{Binding HasSecondary}" Background="{DynamicResource KubismBorderBrush}" />
          <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding HasSecondary}">
            <Border Background="{DynamicResource KubismSidebarBrush}" Padding="8,2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SecondaryWorkspace.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="Close split ×" Command="{Binding CloseSplitCommand}" />
              </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding SecondaryWorkspace}" />
          </Grid>
        </Grid>
        <v:WelcomeView Grid.Row="1" IsVisible="{Binding ShowWelcome}" />
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource KubismBorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" Width="120" Height="6" />
          <TextBlock Text="{Binding BusyText}" />
          <Button Classes="link" Content="Cancel" Command="{Binding CancelBusyCommand}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Ctrl/⌘+K: command palette" Classes="muted" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Global search overlay -->
    <Border Grid.RowSpan="3" IsVisible="{Binding GlobalSearchOpen}" Background="#66000000" PointerPressed="OnSearchBackdrop">
      <Border Classes="card" Width="640" MaxHeight="520" VerticalAlignment="Top" Margin="0,70,0,0" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="SearchBox" Text="{Binding Search.Query, Mode=TwoWay}" PlaceholderText="Search all connected clusters: name, or label key=value" AutomationProperties.Name="Global search" KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Content="Search" Command="{Binding Search.SearchCommand}" Margin="6,0,0,0" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Search.Summary}" Classes="muted" Margin="2,6" />
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Search.Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchGroup">
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Hits}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchHit">
                          <Button Classes="link" Content="{Binding Display}" HorizontalAlignment="Left" Click="OnSearchHitClick" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Command palette overlay -->
    <Border Grid.RowSpan="3" IsVisible="{Binding PaletteOpen}" Background="#66000000" PointerPressed="OnPaletteBackdrop">
      <Border Classes="card" Width="560" MaxHeight="440" VerticalAlignment="Top" Margin="0,80,0,0" Padding="8">
        <Grid RowDefinitions="Auto,*">
          <TextBox Name="PaletteBox" Text="{Binding Palette.Query, Mode=TwoWay}" PlaceholderText="Jump to a kind, namespace or cluster…" AutomationProperties.Name="Command palette" />
          <ListBox Name="PaletteList" Grid.Row="1" ItemsSource="{Binding Palette.Results}" SelectedItem="{Binding Palette.Selected}" Margin="0,6,0,0" DoubleTapped="OnPaletteDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="muted" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
