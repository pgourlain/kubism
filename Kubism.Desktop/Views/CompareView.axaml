<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:app="using:Kubism.Desktop"
             x:Class="Kubism.Desktop.Views.CompareView"
             x:DataType="vm:CompareViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{DynamicResource KubismOkBrush}" /></Style>
    <Style Selector="TextBlock.removed"><Setter Property="Foreground" Value="{DynamicResource KubismErrorBrush}" /></Style>
    <Style Selector="TextBlock.gap"><Setter Property="Foreground" Value="{DynamicResource KubismMutedBrush}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
    <StackPanel Spacing="2" Margin="0,0,0,10">
      <TextBlock Text="Compare clusters" Classes="h1" />
      <TextBlock Text="The same kind of object in two clusters or namespaces: what exists on one side only, and what differs. Server-generated fields are ignored; Secret values are never shown." Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
      <StackPanel Spacing="3">
        <TextBlock Text="THIS CLUSTER" Classes="sectionTitle" />
        <TextBlock Text="{Binding LeftTitle}" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding LeftNamespaces}" SelectedItem="{Binding LeftNamespace}" HorizontalAlignment="Stretch" AutomationProperties.Name="Namespace here" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="⇄" FontSize="22" VerticalAlignment="Center" Classes="muted" />
      <StackPanel Grid.Column="2" Spacing="3">
        <TextBlock Text="COMPARE WITH" Classes="sectionTitle" />
        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" AutomationProperties.Name="Compare with cluster">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding RightNamespaces}" SelectedItem="{Binding RightNamespace}" HorizontalAlignment="Stretch" AutomationProperties.Name="Namespace there" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Bottom">
        <TextBlock Text="KIND" Classes="sectionTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="200" AutomationProperties.Name="Kind" />
          <Button Classes="primary" Content="Compare" Command="{Binding CompareCommand}" IsEnabled="{Binding !IsRunning}" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,6">
      <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding Error}" Foreground="{DynamicResource KubismErrorBrush}" IsVisible="{Binding Error, Converter={x:Static app:Converters.NotNull}}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding NameFilter}" PlaceholderText="Filter by name" Width="170" />
        <CheckBox Content="Show identical" IsChecked="{Binding ShowIdentical}" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="300,6,*">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Compared objects">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CompareRow">
            <Grid ColumnDefinitions="22,*,Auto">
              <TextBlock Text="{Binding Marker}" FontWeight="Bold" Foreground="{Binding Severity, Converter={x:Static app:Converters.SeverityBrush}}" />
              <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Display}" />
              <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="muted" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Background="{DynamicResource KubismBorderBrush}" Width="1" HorizontalAlignment="Center" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="10,0,0,0">
        <TextBlock Text="{Binding DiffTitle}" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
        <Border Grid.Row="1" Classes="card" Padding="0">
          <ListBox ItemsSource="{Binding DiffLines}" Background="Transparent" AutomationProperties.Name="Differences">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,0" /><Setter Property="MinHeight" Value="0" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffLine">
                <TextBlock Text="{Binding Text}" FontFamily="Menlo,Consolas,monospace" FontSize="12" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.gap="{Binding IsGap}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
