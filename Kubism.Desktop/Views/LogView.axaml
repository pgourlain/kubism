<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Kubism.Desktop.Views.LogView"
             x:DataType="vm:LogViewModel">
  <Grid RowDefinitions="Auto,*">
    <WrapPanel Margin="6,4">
      <TextBox Text="{Binding Search}" Watermark="Search" Width="200" Margin="0,0,6,0" AutomationProperties.Name="Search logs" />
      <CheckBox Content="Regex" IsChecked="{Binding UseRegex}" />
      <Button Content="◀" Click="OnPrev" ToolTip.Tip="Previous match" AutomationProperties.Name="Previous match" />
      <Button Content="▶" Click="OnNext" ToolTip.Tip="Next match" AutomationProperties.Name="Next match" />
      <TextBlock Text="{Binding MatchInfo}" Classes="muted" VerticalAlignment="Center" Margin="6,0" />
      <CheckBox Content="Wrap" IsChecked="{Binding Wrap}" />
      <CheckBox Content="Timestamps" IsChecked="{Binding ShowTimestamps}" />
      <CheckBox Content="JSON" IsChecked="{Binding PrettyJson}" ToolTip.Tip="Pretty-print JSON log lines" />
      <ToggleButton Content="Pause" IsChecked="{Binding Paused}" />
      <Button Content="Clear" Command="{Binding ClearCommand}" />
      <Button Content="Download" Command="{Binding DownloadCommand}" />
      <TextBlock Classes="muted" VerticalAlignment="Center" Margin="8,0" Text="{Binding LineCount, StringFormat='{}{0} lines'}" />
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding State}" />
    </WrapPanel>
    <ae:TextEditor Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="False" FontFamily="Menlo,Consolas,DejaVu Sans Mono,monospace" FontSize="12"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Log output" />
  </Grid>
</UserControl>
