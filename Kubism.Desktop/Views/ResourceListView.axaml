<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:v="using:Kubism.Desktop.Views"
             xmlns:app="using:Kubism.Desktop"
             x:Class="Kubism.Desktop.Views.ResourceListView"
             x:DataType="vm:ResourceListViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,10,12,6">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Bottom" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <v:NamespacePicker DataContext="{Binding Workspace.Namespaces}" IsVisible="{Binding $parent[v:ResourceListView].((vm:ResourceListViewModel)DataContext).Namespaced}" />
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter (name, key=value)" Width="220" AutomationProperties.Name="Filter" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Fill="{DynamicResource KubismOkBrush}" IsVisible="{Binding IsLive}" />
        <Ellipse Width="9" Height="9" Fill="{DynamicResource KubismWarnBrush}" IsVisible="{Binding IsReconnecting}" />
        <TextBlock Text="{Binding StateText}" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
        <CheckBox Content="All columns" IsChecked="{Binding ShowAllColumns}" ToolTip.Tip="Columns…" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" IsVisible="{Binding ErrorText, Converter={x:Static app:Converters.NotNull}}" Background="{DynamicResource KubismSidebarBrush}" Padding="12,6">
      <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource KubismErrorBrush}" TextWrapping="Wrap" />
    </Border>
    <DataGrid Name="Grid" Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
              GridLinesVisibility="Horizontal" AutoGenerateColumns="False" Margin="12,0,12,12" AutomationProperties.Name="Resources" />
  </Grid>
</UserControl>
