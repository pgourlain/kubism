<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:v="using:Kubism.Desktop.Views"
             xmlns:app="using:Kubism.Desktop"
             x:Class="Kubism.Desktop.Views.ResourceListView"
             x:DataType="vm:ResourceListViewModel">
  <!-- Star column + clip: the grid's minimum column widths must never stretch the toolbar under the details panel. -->
  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" ClipToBounds="True">
    <!-- Two rows that wrap: Refresh/Delete must stay reachable when the details panel narrows the list. -->
    <StackPanel Grid.Row="0" Margin="12,10,12,6" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Title}" Classes="h1" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
        <Ellipse Width="9" Height="9" Fill="{DynamicResource KubismOkBrush}" IsVisible="{Binding IsLive}" VerticalAlignment="Center" />
        <Ellipse Width="9" Height="9" Fill="{DynamicResource KubismWarnBrush}" IsVisible="{Binding IsReconnecting}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StateText}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <WrapPanel>
        <v:NamespacePicker DataContext="{Binding Workspace.Namespaces}" IsVisible="{Binding $parent[v:ResourceListView].((vm:ResourceListViewModel)DataContext).Namespaced}" Margin="0,0,8,4" />
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter (name, key=value)" Width="220" Margin="0,0,8,4" AutomationProperties.Name="Filter" />
        <CheckBox Content="All columns" IsChecked="{Binding ShowAllColumns}" ToolTip.Tip="Columns…" Margin="0,0,8,4" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
        <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" Foreground="{DynamicResource KubismErrorBrush}" Margin="0,0,8,4" AutomationProperties.Name="Delete selected" />
      </WrapPanel>
    </StackPanel>
    <Border Grid.Row="1" IsVisible="{Binding ErrorText, Converter={x:Static app:Converters.NotNull}}" Background="{DynamicResource KubismSidebarBrush}" Padding="12,6">
      <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource KubismErrorBrush}" TextWrapping="Wrap" />
    </Border>
    <DataGrid Name="Grid" Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
              GridLinesVisibility="Horizontal" AutoGenerateColumns="False" Margin="12,0,12,12" AutomationProperties.Name="Resources" />
  </Grid>
</UserControl>
