<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:v="using:Kubism.Desktop.Views"
             xmlns:app="using:Kubism.Desktop"
             x:Class="Kubism.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- Safety banner: red strip for production, purple for read-only -->
    <Border Grid.Row="0" IsVisible="{Binding HasBanner}" Background="{Binding IsProduction, Converter={x:Static app:Converters.SafetyBrush}}" Padding="10,3">
      <TextBlock Text="{Binding BannerText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
    </Border>
    <Border Grid.Row="0" IsVisible="{Binding !HasBanner}" Height="3" Background="{Binding Color, Converter={x:Static app:Converters.HexBrush}}" />

    <Grid x:Name="MainGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding IsCompact, Converter={x:Static app:Converters.SidebarColumn}}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="0" MinWidth="0" MaxWidth="900" />
      </Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <Grid Background="{DynamicResource KubismPanelBrush}" RowDefinitions="Auto,*" ClipToBounds="True">
        <Border Padding="10,8" BorderBrush="{DynamicResource KubismBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding ServerVersion}" Classes="muted" FontSize="11" />
              <TextBlock Text="degraded" IsVisible="{Binding IsDegraded}" Foreground="{DynamicResource KubismWarnBrush}" FontSize="11" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TreeView Name="NavTree" Grid.Row="1" ItemsSource="{Binding NavRoots}" SelectedItem="{Binding SelectedNav}" Background="Transparent" AutomationProperties.Name="Navigation">
          <TreeView.ItemContainerTheme>
            <ControlTheme x:DataType="vm:NavNode" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="MinHeight" Value="26" />
            </ControlTheme>
          </TreeView.ItemContainerTheme>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:NavNode">
              <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding IsDimmed, Converter={x:Static app:Converters.BoolToOpacityDim}}">
                <Panel Width="16" Height="16" VerticalAlignment="Center">
                  <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource KubismMutedBrush}"
                        Data="{Binding IconKey, Converter={x:Static app:Converters.Icon}}" IsVisible="{Binding IconKey, Converter={x:Static app:Converters.NotNull}}" />
                </Panel>
                <TextBlock Text="{Binding Title}" FontWeight="{Binding IsGroup, Converter={x:Static app:Converters.GroupWeight}}" ToolTip.Tip="{Binding ShortNames}" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
      <GridSplitter Grid.Column="1" Width="1" IsVisible="{Binding !IsCompact}" Background="{DynamicResource KubismBorderBrush}" />

      <!-- Content + dock -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto" ClipToBounds="True">
        <Grid Grid.Row="0" RowDefinitions="Auto,*">
          <!-- Navigation: back / forward / history, and where the user is -->
          <Border Grid.Row="0" Padding="8,4" BorderBrush="{DynamicResource KubismBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="2">
              <Button Grid.Column="0" Classes="nav" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{Binding BackTip}" AutomationProperties.Name="Back">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M15,5 L8,12 L15,19" />
              </Button>
              <Button Grid.Column="1" Classes="nav" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{Binding ForwardTip}" AutomationProperties.Name="Forward">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M9,5 L16,12 L9,19" />
              </Button>
              <Button x:Name="HistoryButton" Grid.Column="2" Classes="nav" Width="22" ToolTip.Tip="History" AutomationProperties.Name="History">
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M6,9 L12,15 L18,9" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryItems}" MinWidth="220">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItem">
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Content="{Binding Title}" FontWeight="{Binding IsCurrent, Converter={x:Static app:Converters.BoolToBold}}"
                                  Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).GoToHistoryItemCommand}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBlock Grid.Column="3" Text="{Binding Crumbs}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Location" />
              <v:NamespacePicker Grid.Column="4" DataContext="{Binding Namespaces}" IsVisible="{Binding $parent[v:WorkspaceView].((vm:WorkspaceViewModel)DataContext).ShowNamespacePicker}" Margin="8,0,0,0" />
            </Grid>
          </Border>
          <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
        </Grid>
        <Border Name="DockHandle" Grid.Row="1" Height="6" Cursor="SizeNorthSouth" IsVisible="{Binding Dock.IsOpen}" Background="{DynamicResource KubismBorderBrush}" AutomationProperties.Name="Resize bottom panel" />
        <v:DockView Grid.Row="2" DataContext="{Binding Dock}" IsVisible="{Binding IsOpen}" Height="{Binding Height, Mode=TwoWay}" />
      </Grid>
      <Border x:Name="DetailsHandle" Grid.Column="3" Width="6" Cursor="SizeWestEast" IsVisible="{Binding Details.IsOpen}" Background="{DynamicResource KubismBorderBrush}" AutomationProperties.Name="Resize details panel" />
      <v:DetailsView Grid.Column="4" DataContext="{Binding Details}" IsVisible="{Binding IsOpen}" />
    </Grid>
  </Grid>
</UserControl>
