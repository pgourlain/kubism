<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kubism.Desktop.ViewModels"
             xmlns:h="using:Kubism.Core.Helm"
             xmlns:app="using:Kubism.Desktop"
             xmlns:c="using:Kubism.Desktop.Controls"
             x:Class="Kubism.Desktop.Views.HelmView"
             x:DataType="vm:HelmViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{DynamicResource KubismOkBrush}" /></Style>
    <Style Selector="TextBlock.removed"><Setter Property="Foreground" Value="{DynamicResource KubismErrorBrush}" /></Style>
    <Style Selector="TextBlock.gap"><Setter Property="Foreground" Value="{DynamicResource KubismMutedBrush}" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="1.15*,Auto,*" Margin="16">
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Helm releases" Classes="h1" />
          <TextBlock Text="Read from release secrets; no helm binary needed to browse." Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadCommand}" VerticalAlignment="Top" />
      </Grid>
      <Border Grid.Row="1" IsVisible="{Binding HasFailing}" Background="{DynamicResource KubismErrorBrush}" Padding="8,4" Margin="0,0,0,6" CornerRadius="4">
        <TextBlock Text="{Binding FailingSummary}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" x:DataType="h:HelmRelease" Width="*" MinWidth="110" />
          <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" x:DataType="h:HelmRelease" />
          <DataGridTextColumn Header="Chart" Binding="{Binding Chart}" x:DataType="h:HelmRelease" />
          <DataGridTextColumn Header="Version" Binding="{Binding ChartVersion}" x:DataType="h:HelmRelease" />
          <DataGridTextColumn Header="App" Binding="{Binding AppVersion}" x:DataType="h:HelmRelease" />
          <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" x:DataType="h:HelmRelease" />
          <DataGridTextColumn Header="Status" Binding="{Binding ., Converter={x:Static app:Converters.HelmHealth}}" x:DataType="h:HelmRelease" MinWidth="120" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <GridSplitter Grid.Column="1" Width="6" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,6" IsVisible="{Binding Selected, Converter={x:Static app:Converters.NotNull}}">
      <Button Content="Edit values…" Command="{Binding EditValuesCommand}" IsEnabled="{Binding CanWrite}" ToolTip.Tip="Change the values and upgrade the release" />
      <Button Content="Roll back…" Command="{Binding ShowHistoryCommand}" IsEnabled="{Binding CanWrite}" ToolTip.Tip="Choose a revision in the History tab" />
      <Button Classes="danger" Content="Uninstall" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanWrite}" ToolTip.Tip="{Binding UninstallTooltip}" />
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Tab, Mode=TwoWay}">
      <TabItem Header="Diagnostics">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="4,8,12,8">
            <Border Classes="card">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding DiagHeadline}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{Binding DiagIsProblem, Converter={x:Static app:Converters.ProblemBrush}}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding DiagLoading}" Height="4" />
                <Button Content="Refresh diagnosis" Command="{Binding RefreshDiagnosisCommand}" HorizontalAlignment="Left" IsVisible="{Binding DiagIsProblem}" />
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding DiagEvents.Count}">
              <StackPanel Spacing="4">
                <TextBlock Text="Warning events" Classes="h2" />
                <ItemsControl ItemsSource="{Binding DiagEvents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="h:DiagEvent">
                      <StackPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" Foreground="{DynamicResource KubismWarnBrush}" />
                          <TextBlock Text="{Binding Object}" />
                          <TextBlock Text="{Binding Age}" Classes="muted" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding DiagPods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:DiagPod">
                  <Border Classes="card" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource KubismErrorBrush}" />
                        <TextBlock Text="{Binding Restarts, StringFormat='{}{0} restarts'}" Classes="muted" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="h:DiagLog">
                            <StackPanel Margin="0,2">
                              <TextBlock Classes="muted" FontSize="11"><Run Text="{Binding Container}" /><Run Text="{Binding Previous, Converter={x:Static app:Converters.PreviousLabel}}" /></TextBlock>
                              <TextBox Text="{Binding Text}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="180" FontFamily="Menlo,Consolas,monospace" FontSize="11" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Values">
        <TextBox Text="{Binding ValuesText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
      </TabItem>
      <TabItem Header="User values">
        <TextBox Text="{Binding UserValuesText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
      </TabItem>
      <TabItem Header="Manifest">
        <TextBox Text="{Binding ManifestText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
      </TabItem>
      <TabItem Header="Notes">
        <TextBox Text="{Binding NotesText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
      </TabItem>
      <TabItem Header="History">
        <Grid RowDefinitions="*,Auto">
          <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Name="HistoryGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" x:DataType="h:HelmRelease" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" x:DataType="h:HelmRelease" />
              <DataGridTextColumn Header="Chart" Binding="{Binding ChartVersion}" x:DataType="h:HelmRelease" />
              <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" x:DataType="h:HelmRelease" />
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" x:DataType="h:HelmRelease" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Roll back to selected revision" Click="OnRollback" IsEnabled="{Binding CanWrite}" ToolTip.Tip="{Binding WriteTooltip}" />
            <Button Content="Uninstall" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanWrite}" ToolTip.Tip="{Binding WriteTooltip}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Upgrade">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,8,8,8">
            <TextBlock Text="Change the values of this release and upgrade it with helm. The values below are the ones supplied when it was installed (helm get values): what you remove returns to the chart's default." Classes="muted" TextWrapping="Wrap" />
            <RadioButton GroupName="chart" IsChecked="{Binding UseInstalledChart}" IsEnabled="{Binding CanRebuild}"><TextBlock Text="The installed chart, rebuilt from the release (same chart and version: only the values change)" TextWrapping="Wrap" /></RadioButton>
            <TextBlock Text="{Binding RebuildBlockedReason}" Foreground="{DynamicResource KubismWarnBrush}" TextWrapping="Wrap" IsVisible="{Binding !CanRebuild}" FontSize="12" Margin="24,0,0,0" />
            <RadioButton GroupName="chart" IsChecked="{Binding UseReference}"><TextBlock Text="A chart from a repository, an OCI registry or a folder (to change the chart version too)" TextWrapping="Wrap" /></RadioButton>
            <Grid ColumnDefinitions="*,120" ColumnSpacing="8" Margin="24,0,0,0" IsEnabled="{Binding UseReference}">
              <TextBox Text="{Binding ChartRef}" PlaceholderText="repo/chart · oci://registry/chart · ./folder" AutomationProperties.Name="Chart reference" />
              <TextBox Grid.Column="1" Text="{Binding ChartVersion}" PlaceholderText="version" AutomationProperties.Name="Chart version" />
            </Grid>
            <TextBlock Text="VALUES" Classes="sectionTitle" />
            <c:YamlEditor Height="170" Text="{Binding UpgradeValues, Mode=TwoWay}" IsReadOnly="False" />
            <StackPanel Orientation="Horizontal" Spacing="14">
              <CheckBox Content="Wait until ready" IsChecked="{Binding Wait}" />
              <CheckBox Content="Atomic (roll back if it fails)" IsChecked="{Binding Atomic}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Preview changes" Command="{Binding PreviewUpgradeCommand}" IsEnabled="{Binding !UpgradeBusy}" />
              <Button Classes="primary" Content="Upgrade" Command="{Binding UpgradeCommand}" IsEnabled="{Binding !UpgradeBusy}" />
              <Button Content="Reset values" Command="{Binding ResetValuesCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding UpgradeError}" Foreground="{DynamicResource KubismErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding UpgradeError, Converter={x:Static app:Converters.NotNull}}" />
            <TextBlock Text="{Binding UpgradeStatus}" TextWrapping="Wrap" />
            <Border Classes="card" Padding="0" IsVisible="{Binding PreviewLines.Count}">
              <ItemsControl ItemsSource="{Binding PreviewLines}" MaxHeight="320">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiffLine">
                    <TextBlock Text="{Binding Text}" FontFamily="Menlo,Consolas,monospace" FontSize="12" Margin="8,0" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.gap="{Binding IsGap}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Graph">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6">
            <TextBlock Text="{Binding GraphStatus}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="Loading…" Classes="muted" IsVisible="{Binding GraphLoading}" VerticalAlignment="Center" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <c:RelationGraphControl Graph="{Binding Graph}" NodeCommand="{Binding OpenGraphNodeCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" />
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
    </Grid>
  </Grid>
</UserControl>
