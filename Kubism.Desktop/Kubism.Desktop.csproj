<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kubism</AssemblyName>
    <RootNamespace>Kubism.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Kubism.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Native AOT for releases (like CinnabarSharp). Opt out with -p:PublishAot=false. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Native AOT only strips debug symbols from the shipped folder -->
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\kubism.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\Kubism.Core\Kubism.Core.csproj" />
    <ProjectReference Include="..\Kubism.Kube\Kubism.Kube.csproj" />
    <ProjectReference Include="..\Kubism.Mcp\Kubism.Mcp.csproj" />
    <ProjectReference Include="..\Kubism.Testing\Kubism.Testing.csproj" />
  </ItemGroup>
</Project>
